# Copy to .env and fill in. .env is gitignored; Bun loads it automatically.
#
#   cp .env.example .env

# Anthropic API key. Required for structured output on the Claude path.
# Create at https://console.anthropic.com -> Settings -> API keys.
# This is billed per token and is separate from a Claude Code subscription:
# the subscription cannot authenticate direct API calls.
ANTHROPIC_API_KEY=

# Gemini API key. Create at https://aistudio.google.com/apikey
# The free tier is rate limited but sufficient for reviewing a few files.
GEMINI_API_KEY=

# Bypasses Claude Code auto-detection so the Anthropic API path is used.
# Both transports return the same schema-constrained review, so this is a cost and
# latency switch rather than a capability one: `claude --print` runs a full agentic
# session costing roughly six times a direct API call. Accepts 1/true/yes/on.
# CODE_REVIEW_FORCE_API=1

# Overrides the per-model output cap. Set low to force truncation when testing
# the failure path; leave unset for the resolved per-model value.
# CODE_REVIEW_MAX_TOKENS=300
